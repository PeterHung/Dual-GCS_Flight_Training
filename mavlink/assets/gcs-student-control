#!/usr/bin/env python3
"""Send on/off/status to the local single-threaded student UDP relay."""

import argparse
import json
import os
from pathlib import Path
import socket
import struct
import sys
import tempfile


RUNTIME = Path("/run/gcs-student-relay")


def request(action, runtime=RUNTIME):
    relay_owner = runtime.stat()
    with tempfile.TemporaryDirectory(prefix="ctl-", dir=runtime) as directory:
        directory = Path(directory)
        os.chown(directory, os.geteuid(), relay_owner.st_gid)
        directory.chmod(0o710)
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
            client.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
            endpoint = directory / "client"
            client.bind(str(endpoint))
            os.chown(endpoint, os.geteuid(), relay_owner.st_gid)
            endpoint.chmod(0o620)
            client.settimeout(3)
            client.sendto(action.encode("ascii"), str(runtime / "control.sock"))
            data, ancillary, flags, _ = client.recvmsg(8192, socket.CMSG_SPACE(12))
            uid = None
            for level, kind, value in ancillary:
                if level == socket.SOL_SOCKET and kind == socket.SCM_CREDENTIALS and len(value) >= 12:
                    _, uid, _ = struct.unpack("3i", value[:12])
            if uid != relay_owner.st_uid or flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
                raise ValueError("Invalid relay reply credentials")
            return json.loads(data)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("on", "off", "status"))
    args = parser.parse_args()
    if sys.platform != "linux" or os.geteuid() != 0:
        parser.error("Run with sudo on the coach GCS")
    if not (RUNTIME / "control.sock").exists():
        parser.error("Student relay is not running. Start the forwarding services first.")
    response = request(args.action)
    if "error" in response:
        parser.error(response["error"])
    print(json.dumps(response, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(f"ERROR: {error}")
